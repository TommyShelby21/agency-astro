---
import { Image } from 'astro:assets';
import mockupImg from '../media/image.png';
---


<section id="work">
	<div class="section-head">
		<div>
			<div class="section-label">
				<span class="n">02</span> Vybraná práce
			</div>
			<h2>Ukázka mé práce</h2>
		</div>
		<div class="desc">Nový web pro školu bojových umění</div>
	</div>

	<div class="case">
		<div class="case-visual">
			<Image src={mockupImg} alt="Mockup redesignu webu" />
		</div>
		<div class="case-body">
			<div class="cat">KONCEPT</div>
			<h3>Přehledný web s jasným výběrem lekcí</h3>
			<p>
				Původní web měl nekonzistentní strukturu a zastaralý design.
				Nový návrh staví na jednoduché hero sekci.
			</p>
			<a
				class="link"
				href="https://www.bojoveumeni-osicka.cz/"
				target="_blank">Zobrazit stránku →</a
			>
		</div>
	</div>
</section>

<style>
	.case {
		display: grid;
		grid-template-columns: minmax(280px, 0.9fr) minmax(0, 1.1fr);
		gap: 0;
		border: 1px solid var(--line);
		border-radius: 4px;
		overflow: hidden;
		margin-bottom: 26px;
		background: var(--card);
	}
	.case-visual {
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 24px;
		min-height: 280px;
		background:
			radial-gradient(
				circle at 25% 20%,
				rgba(255, 90, 31, 0.18),
				transparent 55%
			),
			linear-gradient(155deg, #1c2126, #14181c);
		position: relative;
	}
	.case-visual img {
		width: 100%;
		height: 100%;
		max-height: 320px;
		object-fit: cover;
		border-radius: 6px;
		box-shadow: 0 18px 45px rgba(0, 0, 0, 0.22);
	}
	.case-visual::after {
		content: attr(data-tag);
		position: absolute;
		bottom: 24px;
		left: 24px;
		color: #f7f5f0;
		font-family: "JetBrains Mono", monospace;
		font-size: 0.78rem;
		opacity: 0.7;
	}
	.case-body {
		padding: 40px;
	}
	.case-body .cat {
		font-family: "JetBrains Mono", monospace;
		color: var(--accent);
		font-size: 0.76rem;
		margin-bottom: 12px;
	}
	.case-body h3 {
		font-family: "Space Grotesk", sans-serif;
		font-size: 1.55rem;
		font-weight: 600;
		margin-bottom: 14px;
	}
	.case-body p {
		color: var(--slate);
		font-size: 0.95rem;
		line-height: 1.65;
		margin-bottom: 20px;
	}
	.case-body .link {
		font-weight: 600;
		font-size: 0.9rem;
		border-bottom: 1px solid var(--ink);
		padding-bottom: 2px;
	}
	@media (max-width: 800px) {
		.case {
			grid-template-columns: 1fr;
		}
		.case-visual {
			min-height: 180px;
			padding: 16px;
		}
		.case-visual img {
			max-height: 220px;
		}
	}
</style>
