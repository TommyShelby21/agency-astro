---
const steps = [
	{ n: '01', title: 'Konzultace', desc: 'Rychlá textová komunikace — co potřebujete a jaký je rozpočet.' },
	{ n: '02', title: 'Návrh', desc: 'Mockup designu na schválení, než se začne kódovat.' },
	{ n: '03', title: 'Vývoj', desc: 'Stavba webu s průběžnými aktualizacemi.' },
	{ n: '04', title: 'Spuštění', desc: 'Nasazení' },
];
---

<section style="border-bottom:none; padding-bottom:0;">
	<div class="section-label"><span class="n">04</span> Jak spolupráce probíhá</div>
	<div class="process">
		{steps.map((s) => (
			<div class="proc-step">
				<div class="n">{s.n}</div>
				<h4>{s.title}</h4>
				<p>{s.desc}</p>
			</div>
		))}
	</div>
</section>

<style>
	.process{ display:grid; grid-template-columns: repeat(4,1fr); gap: 0; border-top:1px solid var(--line); border-left:1px solid var(--line); }
	.proc-step{ padding: 30px 24px; border-right:1px solid var(--line); border-bottom:1px solid var(--line); }
	.proc-step .n{ font-family:'Space Grotesk',sans-serif; font-size:1.8rem; font-weight:700; color: var(--line); }
	.proc-step h4{ font-size:1rem; font-weight:600; margin: 10px 0 8px; }
	.proc-step p{ color: var(--slate); font-size:0.85rem; line-height:1.55; }
	@media (max-width: 800px){ .process{ grid-template-columns: repeat(2,1fr);} }
</style>
